# Copy this file to .env and fill in your own values. Never commit .env.

# OpenAI (used by the guardrails, and for answers through Portkey)
OPENAI_API_KEY=

# Portkey LLM Gateway
# The two names must match the providers in your Portkey Model Catalog.
# PORTKEY_PRIMARY_CONFIG_ID is the pc-... ID of the saved config that switches
# from the main model to the backup (find it with scripts/testing/list_portkey_configs.py).
PORTKEY_API_KEY=
PORTKEY_PRIMARY_SLUG=openai-primary
PORTKEY_FALLBACK_SLUG=anthropic-fallback
PORTKEY_PRIMARY_CONFIG_ID=

# Jina AI (embeddings and reranking)
JINA_API_KEY=

# Qdrant vector database
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=

# Neon Postgres (chat memory) and Upstash Redis (rate limiting)
NEON_DB_URL=postgresql://user:password@host.neon.tech/enterprise_rag?sslmode=require
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# API login and rate limiting
RAG_API_KEY=
RATE_LIMIT_PER_MINUTE=20

# Pydantic Logfire (monitoring, optional)
LOGFIRE_TOKEN=
LOGFIRE_BASE_URL=https://logfire-eu.pydantic.dev

# LangSmith (agent tracing, optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-agentic-rag

# API address used by the Streamlit UI
BACKEND_URL=http://localhost:8000

# OpenAI key for the evaluation judge (uses OPENAI_API_KEY if empty)
JUDGE_OPENAI_API_KEY=
